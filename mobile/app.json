{
  "expo": {
    "name": "Matkontroll",
    "slug": "matkontroll",
    "scheme": "matkontroll",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Matkontroll bruker kameraet for å skanne strekkoder.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ]
  }
}
